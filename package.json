{
  "name": "charts-lite",
  "version": "0.0.0",
  "description": "Charts for affiliate programmes as SVG strings: funnels, and later money waterfalls, daily dynamics, breakdowns and cohorts. No inline styles, so it renders under a strict style-src 'self' CSP. A core plus one file per chart; zero dependencies; Node and the browser.",
  "main": "charts.js",
  "types": "charts.d.ts",
  "files": [
    "charts.js",
    "charts.min.js",
    "charts.d.ts",
    "charts-funnel.js",
    "charts-funnel.min.js",
    "charts-funnel.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "size": "node scripts/size.mjs",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "mutate": "node scripts/mutate.mjs",
    "gate:bundle": "node scripts/bundle-gate.mjs"
  },
  "config": {
    "sizeBudget": {
      "charts.js": 4096,
      "charts-funnel.js": 2048
    }
  },
  "keywords": [
    "chart",
    "charts",
    "funnel",
    "affiliate",
    "partner-program",
    "igaming",
    "svg",
    "csp",
    "dataviz",
    "ssr",
    "zero-dependencies",
    "vanilla-js"
  ],
  "author": "301st (https://301.st)",
  "license": "MIT",
  "homepage": "https://github.com/investblog/charts-lite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/investblog/charts-lite.git"
  },
  "bugs": {
    "url": "https://github.com/investblog/charts-lite/issues"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
